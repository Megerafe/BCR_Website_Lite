---
/**
 * ETUSIVU + OTA YHTEYTTÄ – one-page Lite website.
 * All texts and images come from src/content/ (home.yaml, services.yaml, packages.yaml,
 * pages.yaml, faq.yaml, site.yaml).
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCarousel from '../components/ServiceCarousel.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import heroLogo from '../assets/brand/bcr_logo_yellow.png';
import contactImage from '../assets/images/new_pics/BeautyContentRoom.jpg';

const home = (await getEntry('home', 'main'))!.data;
const site = (await getEntry('site', 'main'))!.data;
const contact = (await getEntry('pages', 'yhteys'))!.data;
const { hero, services, split, packages, process, about } = home;
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  <!-- 1 · FULL-WIDTH HERO IMAGE ─────────────────────────────── -->
  <section class="relative" aria-label="BeautyContentRoom">
    <div class="hero-media relative overflow-hidden">
      <Image
        src={hero.image}
        alt={hero.imageAlt}
        widths={[800, 1200, 1800, 2400]}
        sizes="100vw"
        class="absolute inset-0 size-full origin-bottom scale-[1.32] object-cover object-center sm:scale-[1.24] md:origin-center md:scale-[1.06] lg:scale-[1.02]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-black/10" aria-hidden="true"></div>
      <div
        class="hero-overlay pointer-events-none absolute inset-x-0 bottom-3 flex flex-col items-center sm:bottom-6"
        aria-hidden="true"
      >
        <div class="hero-logo">
          <Image
            src={heroLogo}
            alt=""
            widths={[600, 1000, 1400]}
            sizes="(min-width: 1024px) 34vw, 60vw"
            class="hero-logo-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="hero-wordmark display-thin text-center text-butter">
          BeautyContentRoom
        </p>
      </div>
    </div>
  </section>

  <!-- 2 · HERO TEXT ─────────────────────────────────────────── -->
  <section class="px-gutter pt-gutter" aria-labelledby="hero-title">
    <div class="grid bg-white md:grid-cols-2">
      <div class="flex flex-col justify-center px-2 py-10 sm:px-6 sm:py-14 lg:px-12 lg:py-20" data-reveal>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-title" class="display-thin mt-5 text-hero">{hero.title}</h1>
        <p class="mt-6 max-w-md text-ink">{hero.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
          <a href={hero.secondary.href} class="btn btn-outline">{hero.secondary.label}</a>
        </div>
      </div>
      {
        hero.secondImage && (
          <div
            class="relative mx-auto aspect-[4/5] w-full max-w-[17rem] overflow-hidden md:mx-0 md:aspect-auto md:min-h-[30rem] md:max-w-none md:rounded-none"
            data-reveal="clip"
          >
            <Image
              src={hero.secondImage}
              alt={hero.secondImageAlt}
              widths={[600, 900, 1300]}
              sizes="(min-width: 768px) 50vw, 272px"
              class="absolute inset-0 size-full object-cover object-top md:object-center"
            />
          </div>
        )
      }
    </div>
  </section>

  <!-- 3 · SERVICES ──────────────────────────────────────────── -->
  <section id="palvelut" class="pt-[var(--spacing-section)]" aria-labelledby="palvelut-title">
    <SectionHeader id="palvelut-title" title={services.title} text={services.text} cta={services.cta} class="px-gutter" />
    <div class="mt-10 lg:mt-14">
      <ServiceCarousel />
    </div>
  </section>

  <!-- 4 · BRAND STORY ───────────────────────────────────────── -->
  <section class="px-gutter pt-[var(--spacing-section)]" aria-labelledby="split-title">
    <div class="grid items-center gap-4 sm:gap-5 md:grid-cols-12">
      <div class="panel flex flex-col justify-center bg-tan-50 px-6 py-10 sm:px-10 md:col-span-8 lg:px-16 lg:py-16" data-reveal>
        <p class="eyebrow">{split.eyebrow}</p>
        <h2 id="split-title" class="display-bold mt-4 text-display">{split.title}</h2>
        <p class="mt-6 max-w-md text-cocoa/95">{split.text}</p>
        <a href={split.cta.href} class="btn btn-outline mt-8 self-start">{split.cta.label}</a>
      </div>
      <div class="flex justify-center md:col-span-4">
        <div class="panel relative aspect-[4/5] w-full max-w-[15rem] bg-white sm:max-w-[17rem] md:max-w-[20rem]" data-reveal>
          <Image
            src={split.image}
            alt={split.imageAlt}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 768px) 710px, 535px"
            class="absolute inset-0 size-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · PACKAGES ──────────────────────────────────────────── -->
  <section id="paketit" class="pt-[var(--spacing-section)]" aria-labelledby="paketit-title">
    <SectionHeader id="paketit-title" title={packages.title} text={packages.text} class="px-gutter" />
    <div class="mt-10 lg:mt-14">
      <PackageCards customTitle={packages.customTitle} customText={packages.customText} customCta={packages.customCta} />
    </div>
  </section>

  <!-- 6 · PROCESS ───────────────────────────────────────────── -->
  <section id="prosessi" class="pt-[var(--spacing-section)]" aria-labelledby="process-title">
    <SectionHeader id="process-title" title={process.title} text={process.text} class="px-gutter" />
    <div class="mt-10 lg:mt-14">
      <ProcessSteps steps={process.steps} />
    </div>
  </section>

  <!-- 7 · ABOUT TEASER ──────────────────────────────────────── -->
  <section id="tietoa" class="px-gutter pt-[var(--spacing-section)]" aria-labelledby="about-title">
    <div class="grid items-center gap-4 sm:gap-5 md:grid-cols-12">
      <div class="flex justify-center md:col-span-4">
        <div class="panel relative aspect-[3/4] w-full max-w-[15rem] bg-white sm:max-w-[17rem] md:max-w-[20rem]" data-reveal>
          <Image
            src={about.image}
            alt={about.imageAlt}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 320px, 240px"
            class="absolute inset-0 size-full object-cover object-top"
          />
        </div>
      </div>
      <div class="panel flex flex-col justify-center bg-tan-50 px-6 py-10 sm:px-10 md:col-span-8 lg:px-16 lg:py-16" data-reveal>
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title" class="display-thin mt-4 text-display">{about.title}</h2>
        <p class="mt-6 max-w-lg text-ink">{about.text}</p>
        <a href={about.cta.href} class="btn btn-outline mt-8 self-start">{about.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- 8 · OTA YHTEYTTÄ (FULL CONTACT SECTION) ───────────────── -->
  <section id="yhteys" class="px-gutter pt-[var(--spacing-section)]" aria-labelledby="contact-title">
    <div class="grid gap-3 sm:gap-4 lg:grid-cols-12 lg:gap-5">
      <!-- left: intro + contact details + still-life photo -->
      <div class="flex flex-col gap-3 sm:gap-4 lg:col-span-5 lg:gap-5">
        <div class="panel bg-blush-50 px-6 pb-10 pt-12 sm:px-10 lg:px-12 lg:pb-12 lg:pt-16" data-reveal>
          {contact.eyebrow && <p class="eyebrow">{contact.eyebrow}</p>}
          <h2 id="contact-title" class="display-thin mt-4 text-hero">{contact.title}</h2>
          <p class="mt-6 max-w-md text-ink">{contact.intro}</p>
          <ul class="mt-10 space-y-3 border-t border-cocoa/15 pt-6 text-ink">
            {
              site.email && (
                <li class="flex items-center gap-3">
                  <Icon name="mail" class="size-5 text-rose-deep" />
                  <a href={`mailto:${site.email}`} class="text-link">
                    {site.email}
                  </a>
                </li>
              )
            }
            {
              site.phone && (
                <li class="flex items-center gap-3">
                  <Icon name="phone" class="size-5 text-rose-deep" />
                  <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-link">
                    {site.phone}
                  </a>
                </li>
              )
            }
            {
              site.instagram?.url && (
                <li class="flex items-center gap-3">
                  <Icon name="instagram" class="size-5 text-rose-deep" />
                  <a
                    href={site.instagram.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link"
                    aria-label={`Instagram ${site.instagram.handle || ''}`.trim()}
                  >
                    {site.instagram.handle || 'Instagram'}
                  </a>
                </li>
              )
            }
            {
              site.tiktok?.url && (
                <li class="flex items-center gap-3">
                  <Icon name="tiktok" class="size-5 text-rose-deep" />
                  <a
                    href={site.tiktok.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link"
                    aria-label={`TikTok ${site.tiktok.handle || ''}`.trim()}
                  >
                    {site.tiktok.handle || 'TikTok'}
                  </a>
                </li>
              )
            }
            {
              (site.location || site.serviceArea) && (
                <li class="flex items-start gap-3">
                  <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-rose-deep" />
                  <span>{[site.location, site.serviceArea].filter(Boolean).join(' · ')}</span>
                </li>
              )
            }
          </ul>
        </div>
        <div class="panel relative hidden flex-1 lg:block lg:min-h-[22rem]" data-reveal="clip">
          <Image
            src={contactImage}
            alt="Vaaleanpunaiset tulppaanit maljakossa valoisalla pöydällä"
            widths={[600, 900]}
            sizes="40vw"
            class="absolute inset-0 size-full object-cover"
          />
        </div>
      </div>

      <!-- right: contact form -->
      <div class="panel bg-tan-50 px-5 py-8 sm:px-10 sm:py-12 lg:col-span-7 lg:px-12 lg:py-14" data-reveal>
        <h3 class="display-bold text-title">{contact.formTitle || 'kerro, mitä tarvitset'}</h3>
        <p class="mt-2 max-w-lg text-sm text-cocoa/90">
          {contact.formIntro || 'Vastaan kaikkiin viesteihin henkilökohtaisesti. Tarjouspyyntö ei sido sinua mihinkään.'}
        </p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · FAQ ──────────────────────────────────────────────── -->
  <section id="ukk" class="px-gutter pt-[var(--spacing-section)]" aria-labelledby="faq-title">
    <div class="flex flex-col gap-8 lg:gap-10">
      <div data-reveal>
        <h2 id="faq-title" class="display-bold text-display">usein kysyttyä:</h2>
      </div>
      <div data-reveal>
        <FaqList />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-media {
    height: clamp(12.5rem, 48vw, 35rem);
  }
  .hero-overlay {
    gap: clamp(0.5rem, 1.8vw, 1.65rem);
  }
  .hero-logo {
    position: relative;
    width: clamp(6rem, 18vw, 17rem);
    aspect-ratio: 1145 / 435;
    overflow: hidden;
    filter: drop-shadow(0 0.15rem 1.25rem rgb(0 0 0 / 0.24));
  }
  .hero-logo-img {
    position: absolute;
    width: 174.6725%;
    max-width: none;
    height: auto;
    left: -37.2926%;
    top: -146.4368%;
  }
  .hero-wordmark {
    width: calc(100% - 1rem);
    padding-inline: 0.5rem;
    font-size: clamp(2rem, 9.5vw, 12rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--color-butter);
    text-shadow: 0 0.15rem 1.5rem rgb(0 0 0 / 0.24);
  }
</style>
