---
/** In-page accessible privacy notice modal so visitors never leave the one-page site or lose their form inputs. Data: pages.yaml (id: tietosuoja) */
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';

const privacy = (await getEntry('pages', 'tietosuoja'))!.data;
---

<dialog id="tietosuoja-dialog" class="privacy-dialog panel mx-auto my-auto w-[min(92vw,46rem)] max-h-[85dvh] bg-white p-0 text-cocoa" aria-labelledby="tietosuoja-title" data-privacy-dialog>
  <div class="sticky top-0 z-10 flex items-start justify-between gap-4 bg-blush-50 px-6 py-6 sm:px-8">
    <div>
      {privacy.eyebrow && <p class="eyebrow">{privacy.eyebrow}</p>}
      <h2 id="tietosuoja-title" class="display-thin mt-2 text-display">{privacy.title}</h2>
    </div>
    <button
      type="button"
      class="flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-cocoa/20 bg-white text-cocoa transition-colors hover:bg-cocoa hover:text-white"
      aria-label="Sulje tietosuojaseloste"
      data-privacy-close
    >
      <Icon name="x" class="size-5" />
    </button>
  </div>

  <div class="overflow-y-auto px-6 py-6 sm:px-8 sm:py-8">
    {privacy.intro && <p class="text-ink">{privacy.intro}</p>}
    <div class="mt-6">
      {
        privacy.body.map((b) => (
          <div class="grid gap-2 border-t border-cocoa/15 py-5 sm:grid-cols-3 sm:gap-6">
            <h3 class="label text-ink">{b.heading}</h3>
            <p class="text-sm leading-relaxed sm:col-span-2">{b.text}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-4 flex justify-end border-t border-cocoa/15 pt-5">
      <button type="button" class="btn btn-outline btn-sm cursor-pointer" data-privacy-close>Sulje</button>
    </div>
  </div>
</dialog>

<style>
  .privacy-dialog {
    overflow: hidden;
    border: 1px solid rgb(91 70 60 / 0.12);
    box-shadow: 0 24px 64px rgb(74 58 50 / 0.22);
  }
  .privacy-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: dialog-in 0.35s var(--ease-soft);
  }
  .privacy-dialog::backdrop {
    background: rgb(74 58 50 / 0.42);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-privacy-dialog]');
  if (dialog) {
    document.addEventListener('click', (e) => {
      const openBtn = (e.target as HTMLElement | null)?.closest('[data-privacy-open]');
      if (openBtn) {
        e.preventDefault();
        dialog.showModal();
        return;
      }
      const closeBtn = (e.target as HTMLElement | null)?.closest('[data-privacy-close]');
      if (closeBtn) {
        dialog.close();
      }
    });

    // Close when clicking the backdrop outside the dialog panel
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
